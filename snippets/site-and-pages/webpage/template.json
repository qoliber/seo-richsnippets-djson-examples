{
    "@context": "https://schema.org/",
    "@type": "WebPage",
    "@djson if page.title": {
        "name": "{{page.title}}"
    },
    "@djson if page.description": {
        "description": "{{page.description}}"
    },
    "@djson if page.url": {
        "url": "{{page.url}}"
    },
    "publisher": "{{snippet.organization}}"
}
